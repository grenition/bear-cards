      m_Items: []
  - m_Id: 363507152314368
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u044F \u0441\u0432\u043E\u0435\u043C\u0443
      \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u043C\u0443 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E
      \u0438\u043C\u0435\u0435\u0442 \u0441\u0430\u043C\u044B\u0435 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0441\u0442\u0435\u043F\u0435\u043D\u0438 \u043E\u043A\u0438\u0441\u043B\u0435\u043D\u0438\u044F,
      \u0432\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u043E\u0441\u0442\u0430\u0432
      \u043A\u0430\u043A \u043A\u0430\u0442\u0438\u043E\u043D\u043E\u0432, \u0442\u0430\u043A
      \u0438 \u0430\u043D\u0438\u043E\u043D\u043E\u0432. \u0415\u0433\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
      \u0441\u0430\u043C\u044B\u0445 \u0440\u0430\u0437\u043D\u044B\u0445 \u0446\u0432\u0435\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
