  - m_Id: 684262022668288
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043A\u0430\u0440\u0442\u0430 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442\u0441\u044F, \u0442\u043E
      \u0432\u044B \u043A\u043E\u043F\u0438\u0442\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u044B
      \u043D\u0430 \u0441\u0432\u043E\u0438\u0445 \u043E\u0440\u0431\u0438\u0442\u0430\u043B\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 684388963278848
    m_Localized: "\u041D\u0430 \u043E\u0440\u0431\u0438\u0442\u0430\u043B\u044C \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043E\u0432,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u043E\u0438\u043B\u0430
      \u043A\u0430\u0440\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 684570492755968
    m_Localized: "\u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043E\u0432
      \u043D\u0430 \u043E\u0440\u0431\u0438\u0442\u0430\u043B\u044F\u0445, \u0442\u0435\u043C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0430\u0448 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C.\n<b>\u041A\u0430\u0436\u0434\u044B\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      +2 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D \u043D\u0430 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0445\u043E\u0434.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 684825229615104
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u0432\u044B\u0437\u0432\u0430\u0442\u044C
      \u043A\u0430\u0440\u0442\u0443 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u043C\u0435\u0442\u044C \u043D\u0443\u0436\u043D\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043E\u0432,
      \u043D\u0443\u0436\u043D\u043E \u0442\u0430\u043A\u0436\u0435 \u0438\u043C\u0435\u0442\u044C
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u044B\u0439 \u042D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 685026283577344
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u0430\u0448 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0440\u0430\u0432\u0435\u043D \u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0443\u0440\u043E\u0432\u043D\u044E \u043A\u0430\u0440\u0442\u044B, \u0442\u043E
      \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u044D\u0442\u0443 \u043A\u0430\u0440\u0442\u0443, \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432
      \u043D\u0443\u0436\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 685132449800192
    m_Localized: "\u0423\u0437\u043D\u0430\u0442\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u043A\u0430\u0440\u0442\u044B \u043C\u043E\u0436\u043D\u043E \u043F\u043E
      \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0446\u0438\u0444\u0440\u0435
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C
      \u043E\u0440\u0431\u0438\u0442\u0430\u043B\u0435\u0439 (\u0431\u0443\u043A\u0432\u0430\u043C\u0438)
      \u0432 \u0435\u0433\u043E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439
      \u0444\u043E\u0440\u043C\u0443\u043B\u0435."
    m_Metadata:
      m_Items: []
