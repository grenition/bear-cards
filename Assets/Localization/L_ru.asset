      \u043A\u0430\u043A \u0432 \u043A\u0430\u043A\u043E\u043C-\u0442\u043E \u0442\u0440\u0435\u043D\u0430\u0436\u0451\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 476729326952448
    m_Localized: "\u0412 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0445\u0438\u043C\u0438\u0438
      \u0432\u0441\u0451 \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0441\u043B\u043E\u0436\u043D\u0435\u0435,
      \u0438 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u044D\u0442\u043E,
      \u0410\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 476765595099136
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u0438 \u0435\u0441\u0442\u044C
      \u0441\u0443\u0442\u044C, \u0414\u043C\u0438\u0442\u0440\u0438\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 476802404311040
    m_Localized: "\u0417\u0430\u0434\u0430\u0447\u0430 \u043D\u0435 \u0432 \u0442\u043E\u043C,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C,
      \u0430 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C,
      \u043A\u0430\u043A \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 476839024779264
    m_Localized: "\u042D\u0442\u043E \u043A\u0430\u043A \u0442\u0432\u043E\u0439
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0439 \u043E\u043F\u044B\u0442,
      \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0434\u0435\u0441\u044C \u0442\u044B
      \u0441\u0430\u043C \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0448\u044C
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 476915101065216
    m_Localized: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0432 \u044D\u0442\u043E\u043C
      \u0447\u0442\u043E-\u0442\u043E \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 476954561077248
    m_Localized: "\u041D\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0435
      \u0442\u0435\u043E\u0440\u0438\u0438, \u0447\u0435\u043C \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0438\u0433\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 477054100299776
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u044F
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0437\u0430\u0446\u0438\u043A\u043B\u0435\u043D
      \u043D\u0430 \u0441\u0442\u0430\u0440\u044B\u0445 \u043C\u0435\u0442\u043E\u0434\u0430\u0445..."
    m_Metadata:
      m_Items: []
  - m_Id: 477108638834688
    m_Localized: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u0432\u0441\u0451 \u044D\u0442\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u043E
      \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u0442\u044B, \u041F\u0430\u0448\u0430,
      \u043D\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 477143384449024
    m_Localized: "\u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A, \u0414\u043C\u0438\u0442\u0440\u0438\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 477180239798272
    m_Localized: "\u041D\u0430\u0443\u043A\u0430 \u0438 \u0438\u0433\u0440\u044B
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438,
      \u0430 \u0434\u0432\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u0430 \u043F\u043E\u043D\u044F\u0442\u044C
      \u043C\u0438\u0440 \u0438 \u0435\u0433\u043E \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 477216621191168
    m_Localized: "\u0421\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u044D\u0442\u0438\u0445
      \u0434\u0432\u0443\u0445 \u043F\u043E\u0434\u0445\u043E\u0434\u043E\u0432 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0431\u043E\u043B\u0435\u0435
      \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 477255250731008
    m_Localized: "\u042D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430. \u041A\u043E\u0433\u0434\u0430
      \u044F \u0432\u0438\u0436\u0443, \u043A\u0430\u043A \u043A\u0430\u0440\u0442\u044B
      \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442,
      \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0442\u043E \u0432\u0441\u0451
      \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0433\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 477287693672448
    m_Localized: "\u042D\u0442\u043E \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430
      \u043C\u043E\u0437\u0433\u0430, \u043F\u043E\u0438\u0441\u043A \u0440\u0435\u0448\u0435\u043D\u0438\u0439,
      \u043A\u0430\u043A \u0438 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 477328474890240
    m_Localized: "\u041C\u0438\u043B\u043B\u0438\u0430\u0440\u0434 \u043E\u0447\u043A\u043E\u0432
      \u0442\u0435\u0431\u0435, \u044E\u043D\u044B\u0439 \u043C\u0435\u0434\u0432\u0435\u0434\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 477385605505024
    m_Localized: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447,
      \u044D\u0442\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 477435052154880
    m_Localized: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E, \u043D\u043E \u043C\u043D\u0435
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u044F \u043E\u0441\u0432\u043E\u0438\u043B
      \u044D\u0442\u043E \u043D\u0430 100%!"
    m_Metadata:
      m_Items: []
  - m_Id: 477473635557376
    m_Localized: "\u0422\u044B \u0441\u0434\u0435\u043B\u0430\u043B \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439
      \u0448\u0430\u0433 \u0432\u043F\u0435\u0440\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 477506158190592
    m_Localized: "\u041D\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u0438: \u043D\u0430\u0443\u043A\u0430
      \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u0430, \u0438 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F \u0447\u0442\u043E-\u0442\u043E
      \u043D\u043E\u0432\u043E\u0435, \u0447\u0435\u043C\u0443 \u043C\u043E\u0436\u043D\u043E
      \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 477619521839104
    m_Localized: "\u041D\u0430\u0441\u0442\u0430\u043B\u043E \u0432\u0440\u0435\u043C\u044F
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0442\u0432\u043E\u0438
      \u0443\u043C\u0435\u043D\u0438\u044F, \u041F\u0430\u0432\u0435\u043B!"
    m_Metadata:
      m_Items: []
  - m_Id: 477746202402816
    m_Localized: "\u0427\u0442\u043E \u0437\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 477791622520832
    m_Localized: "\u042D\u0439, \u044F \u0436\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u044D\u0442\u0443 \u0441\u0442\u0430\u0440\u0443\u044E \u043A\u043E\u043D\u0441\u043E\u043B\u044C!
      \u0422\u0435\u043F\u0435\u0440\u044C \u0447\u0442\u043E, \u044F \u0432 \u0438\u0433\u0440\u0435?!"
    m_Metadata:
      m_Items: []
  - m_Id: 477835570438144
    m_Localized: "\u0425\u043C, \u0412\u044B \u043A\u0442\u043E \u0442\u0430\u043A\u043E\u0439,
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043C\u0435\u0434\u0432\u0435\u0434\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 477879551909888
    m_Localized: "\u042F \u041F\u0430\u0448\u0430! \u0410 \u0432\u044B \u043A\u0442\u043E?
      \u0418 \u0433\u0434\u0435 \u043C\u044B \u0432\u043E\u043E\u0431\u0449\u0435?!"
    m_Metadata:
      m_Items: []
  - m_Id: 477923390775296
    m_Localized: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447,
      \u0443\u0447\u0451\u043D\u044B\u0439, \u0431\u0438\u043E\u0438\u043D\u0436\u0435\u043D\u0435\u0440,
      \u0445\u0438\u043C\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 477962653655040
    m_Localized: "\u0410 \u0433\u0434\u0435 \u043C\u044B\u2026 \u042D\u0445, \u0434\u043E\u043B\u0433\u0430\u044F
      \u0438\u0441\u0442\u043E\u0440\u0438\u044F. \u0422\u044B \u043F\u043E\u043F\u0430\u043B
      \u0432 \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044E, \u0438 \u0435\u0441\u043B\u0438
      \u043D\u0435 \u0445\u043E\u0447\u0435\u0448\u044C \u0437\u0430\u0441\u0442\u0440\u044F\u0442\u044C
      \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430,
      \u0442\u043E \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u043D\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 478000737935360
    m_Localized: "\u0421\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044F? \u042F
      \u0432 \u0432\u0438\u0434\u0435\u043E\u0438\u0433\u0440\u0435? \u0422\u0430\u043A,
      \u043F\u043E\u0433\u043E\u0434\u0438\u0442\u0435\u2026 \u0410 \u0432\u044B
      \u043E\u0442\u043A\u0443\u0434\u0430 \u0437\u0434\u0435\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 478038318899200
    m_Localized: "\u041C\u043D\u0435 \u0431\u044B \u0441\u0430\u043C\u043E\u043C\u0443
      \u044D\u0442\u043E \u043F\u043E\u043D\u044F\u0442\u044C. \u041D\u043E \u044F\u0441\u043D\u043E
      \u043E\u0434\u043D\u043E \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442\u0441\u044E\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441 \u0442\u0432\u043E\u0435\u0439 \u043F\u043E\u043C\u043E\u0449\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 478088675713024
    m_Localized: "\u0421 \u043C\u043E\u0435\u0439? \u0410 \u0441\u0430\u043C\u0438
      \u0432\u044B \u0447\u0442\u043E, \u0438\u0433\u0440\u0430\u0442\u044C \u043D\u0435
      \u0443\u043C\u0435\u0435\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 478177645289472
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u043C\u0435\u0434\u0432\u0435\u0434\u044C,
      \u044F \u0443\u0447\u0438\u043B\u0441\u044F \u0432 \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0438,
      \u0430 \u043D\u0435 \u043D\u0430 \u043A\u043E\u043D\u0441\u043E\u043B\u044F\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 478220959866880
    m_Localized: "\u041D\u043E \u043A\u043E\u0435-\u0447\u0442\u043E \u044F \u0437\u043D\u0430\u044E.
      \u042D\u0442\u0430 \u0438\u0433\u0440\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430
      \u043D\u0430 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 478256233963520
    m_Localized: "\u041C\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u2014
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u0442\u0435\u0431\u0435
      \u0438\u0445 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430, \u0442\u0432\u043E\u044F
      \u2014 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u0445 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 478294947389440
    m_Localized: "\u041B\u0430\u0434\u043D\u043E, \u0437\u0432\u0443\u0447\u0438\u0442
      \u043A\u0430\u043A \u043F\u043B\u0430\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 478332582879232
    m_Localized: "\u0425\u043E\u0442\u044F \u043C\u043D\u0435 \u044D\u0442\u043E
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u043A\u0430\u043A\u0438\u043C-\u0442\u043E \u0441\u0443\u043C\u0430\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 478372856586240
    m_Localized: "\u041F\u0440\u0438\u0432\u044B\u043A\u0430\u0439, \u041F\u0430\u0432\u0435\u043B.
      \u042D\u0442\u043E \u0435\u0449\u0451 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430\u0447\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 478488518713344
    m_Localized: "\u0412\u043E\u0434\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0442\u0430\u043A\u043E\u0439 \u0447\u0438\u0441\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 478574065737728
    m_Localized: "\u042D\u0442\u043E\u0442 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439
      \u0433\u043E\u043B\u0443\u0431\u043E\u0439 \u0446\u0432\u0435\u0442 \u0432\u043E\u0434\u044B
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043C\u043D\u0435
      \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u0422\u0435\u0442\u0438\u0441,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u043B\u0435\u0442\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 478610031894528
    m_Localized: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447,
      \u0442\u0430\u043A \u0432\u044B \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u0432 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0438 \u043D\u0430
      \u0422\u0435\u0442\u0438\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 478654546042880
    m_Localized: "\u0414\u0430, \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \u0441 \u0431\u0435\u0441\u043A\u0440\u0430\u0439\u043D\u0438\u043C
      \u043E\u043A\u0435\u0430\u043D\u043E\u043C. \u0425\u043E\u0442\u0435\u043B
      \u0431\u044B \u044F \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0442\u0443\u0434\u0430 \u0432\u043D\u043E\u0432\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 478757247770624
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u043C\u0435\u0434\u0432\u0435\u0434\u044C,
      \u0442\u044B \u043D\u0435 \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u043B\u0441\u044F
      \u043F\u043E\u0447\u0435\u043C\u0443 \u0444\u043E\u043D\u0442\u0430\u043D \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043E\u0447\u043A\u0438 \u0436\u0438\u0437\u043D\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 478810905501696
    m_Localized: "\u0414\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0447\u0430\u0441\u0442\u043E
      \u0432 \u0438\u0433\u0440\u0430\u0445, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u0444\u044D\u043D\u0442\u0435\u0437\u0438 \u0436\u0430\u043D\u0440\u0430,
      \u0444\u043E\u043D\u0442\u0430\u0442\u044B \u0438\u043B\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 478849828642816
    m_Localized: "\u0425\u043C, \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E.
      \u042D\u0442\u043E \u0432\u0435\u0440\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 478885346009088
    m_Localized: "\u0412\u043E\u0434\u0430 \u2014 \u043E\u0441\u043D\u043E\u0432\u0430
      \u0436\u0438\u0437\u043D\u0438, \u041F\u0430\u0448\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 478918636199936
    m_Localized: "\u0412 \u0445\u0438\u043C\u0438\u0438 \u0435\u0451 \u0440\u043E\u043B\u044C
      \u0441\u043B\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u043E\u0446\u0435\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 478954224869376
    m_Localized: "\u0410 \u0437\u0434\u0435\u0441\u044C, \u043F\u043E\u0445\u043E\u0436\u0435,
      \u0435\u0451 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0432 \u0434\u0440\u0443\u0433\u043E\u043C
      \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 479620095795200
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u043F\u043E\u0441\u043B\u0435
      \u0444\u043E\u043D\u0442\u0430\u043D\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E
      \u0441\u0435\u0431\u044F \u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 479656422662144
    m_Localized: "\u042D\u0442\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
      \u043E \u0432\u0430\u0436\u043D\u043E\u0441\u0442\u0438 \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u043E\u0432,
      \u041F\u0430\u0448\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 479693785522176
    m_Localized: "\u0414\u0430\u0436\u0435 \u0432 \u043D\u0430\u0443\u043A\u0435
      \u043D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 479775255683072
    m_Localized: "\u0418\u043D\u0430\u0447\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u043D\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0439, \u043D\u0438
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 479845699018752
    m_Localized: "\u0412\u0438\u0436\u0443, \u0442\u044B \u043D\u0435 \u0441\u0434\u0430\u0451\u0448\u044C\u0441\u044F.
      \u042D\u0442\u043E \u043F\u043E\u0445\u0432\u0430\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 479884617965568
    m_Localized: "\u041D\u043E \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u043B\u0438 \u0442\u044B, \u0447\u0442\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0437\u0430\u0446\u0438\u043A\u043B\u0438\u043B\u0441\u044F \u043D\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0445
      \u043F\u043E\u0431\u0435\u0434\u0430\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 479917803298816
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043F\u043E\u0431\u0435\u0434\u044B
      \u0442\u043E\u0436\u0435 \u0432\u0430\u0436\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 479981632217088
    m_Localized: "\u0425\u0430, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E.
      \u041D\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u0445\u0438\u043C\u0438\u044F
      \u2014 \u044D\u0442\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u0438\u0441\u043A
      \u0447\u0435\u0433\u043E-\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435\u0433\u043E.
      \u041E\u043F\u044B\u0442\u0430. \u0420\u0438\u0441\u043A\u0430. \u0413\u0440\u0430\u043D\u0438\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 480015585107968
    m_Localized: "\u041D\u0435 \u0441\u043B\u0443\u0448\u0430\u0439 \u0435\u0433\u043E,
      \u041F\u0430\u0448\u0430. \u041D\u0430\u0443\u043A\u0430 \u2014 \u044D\u0442\u043E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u0430 \u043D\u0435 \u0445\u0430\u043E\u0441!"
    m_Metadata:
      m_Items: []
  - m_Id: 480055129006080
    m_Localized: "\u0410 \u0447\u0442\u043E, \u0435\u0441\u043B\u0438 \u0445\u0430\u043E\u0441
      \u2014 \u043B\u0438\u0448\u044C \u0444\u043E\u0440\u043C\u0430 \u043F\u043E\u0440\u044F\u0434\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u044B \u0435\u0449\u0451
      \u043D\u0435 \u043F\u043E\u043D\u044F\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 480182510018560
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E, \u041F\u0430\u0448\u0430, \u0443\u0436\u0435
      \u0443\u0441\u043F\u0435\u043B \u043E\u0441\u043E\u0437\u043D\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0445\u0438\u043C\u0438\u044F \u2014 \u044D\u0442\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0433\u0440\u0430,
      \u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u0431\u0438\u0442\u0432\u0430
      \u0443\u043C\u043E\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 480249866346496
    m_Localized: "\u0427\u0442\u043E \u0437\u0430... \u041A\u0442\u043E \u0442\u044B
      \u0442\u0430\u043A\u043E\u0439?!"
    m_Metadata:
      m_Items: []
  - m_Id: 480283198480384
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u044C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C\u0441\u044F.
      \u042F \u2014 \u0410\u0440\u043D\u043E. \u0413\u0435\u043D\u0438\u0439, \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C
      \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u044B \u0438, \u043A\u0430\u043A
      \u0431\u044B \u044D\u0442\u043E \u043D\u0438 \u0437\u0432\u0443\u0447\u0430\u043B\u043E,
      \u0442\u0432\u043E\u0439 \u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 480711738908672
    m_Localized: "\u0425\u0430-\u0445\u0430. \u041F\u0440\u043E\u0438\u0433\u0440\u0430\u043B
      \u0442\u044B \u0441\u0430\u043C, \u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u0430\u043C. \u042F \u043B\u0438\u0448\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u0442\u0435\u0431\u044F \u0436\u0434\u0435\u0442 \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 480778109575168
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C \u0438\u0433\u0440\u044B?
      \u042D\u0442\u043E \u0442\u044B \u043F\u043E\u0434\u0441\u0442\u0440\u043E\u0438\u043B,
      \u0447\u0442\u043E\u0431\u044B \u044F \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 480997912076288
    m_Localized: "\u041D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u0438\u0436\u0443,
      \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u0435\u043D...
      \u0441\u043A\u0430\u0436\u0435\u043C \u0442\u0430\u043A, \u0443\u0447\u0438\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 481044271718400
    m_Localized: "\u0410\u0440\u043D\u043E, \u043D\u0435 \u043F\u0440\u0435\u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0439
      \u0441\u0432\u043E\u044E \u0437\u043D\u0430\u0447\u0438\u043C\u043E\u0441\u0442\u044C.
      \u041C\u044B \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0438\u0441\u044C
      \u0438 \u0431\u0435\u0437 \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 481086260895744
    m_Localized: "\u0410\u0445, \u0441\u0442\u0430\u0440\u0438\u043D\u0430. \u0422\u044B
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C? \u0422\u044B
      \u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u044F
      \u0442\u043E\u0436\u0435 \u0443\u0432\u0430\u0436\u0430\u044E \u043D\u0430\u0443\u043A\u0443.
      \u041F\u0440\u043E\u0441\u0442\u043E \u044F \u0432\u0438\u0436\u0443 \u0432\u0435\u0449\u0438
      \u0438\u043D\u0430\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 481125980954624
    m_Localized: "\u0418 \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C?
      \u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043D\u0430\u0443\u0447\u0438\u0448\u044C \u043C\u0435\u043D\u044F,
      \u043A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 481188178288640
    m_Localized: "\u041D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C. \u042F \u0431\u0443\u0434\u0443
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C, \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C,
      \u043F\u043E\u0434\u043A\u0438\u0434\u044B\u0432\u0430\u0442\u044C \u043F\u0430\u0440\u043E\u0447\u043A\u0443
      \u0438\u0434\u0435\u0439. \u041D\u043E \u0443\u0447\u0438\u0442\u044C\u0441\u044F
      \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C \u0441\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 481235443900416
    m_Localized: "\u041E\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u0439\u0441\u044F,
      \u041F\u0430\u0448\u0430. \u042D\u0442\u043E\u0442 \u043F\u0430\u0440\u0435\u043D\u044C
      \u043B\u044E\u0431\u0438\u0442 \u0437\u0430\u043F\u0443\u0442\u044B\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 481283061833728
    m_Localized: "\u041E, \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u044C,
      \u0414\u043C\u0438\u0442\u0440\u0438\u0439. \u0414\u0430\u0432\u0430\u0439
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0437\u043E\u0432\u0451\u043C
      \u044D\u0442\u043E \"\u0432\u0435\u0441\u0451\u043B\u044B\u043C \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u043E\u043C\"."
    m_Metadata:
      m_Items: []
  - m_Id: 481318235267072
    m_Localized: "\u041B\u0430\u0434\u043D\u043E, \u0440\u0430\u0437 \u0442\u044B
      \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C, \u0443 \u043C\u0435\u043D\u044F
      \u0435\u0441\u0442\u044C \u043A \u0442\u0435\u0431\u0435 \u043E\u0434\u0438\u043D
      \u0432\u043E\u043F\u0440\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 481358387339264
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u0442\u044B \u0432\u043E\u043E\u0431\u0449\u0435
      \u0437\u0430\u0442\u0435\u044F\u043B \u0432\u0441\u0451 \u044D\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 481394525462528
    m_Localized: "\u0410\u0445, \u041F\u0430\u0448\u0430, \u0442\u044B \u043D\u0435
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C! \u042D\u0442\u043E
      \u043D\u0435 \u0441\u0442\u0440\u0430\u043D\u043D\u043E \u2014 \u044D\u0442\u043E
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 481439798779904
    m_Localized: "\u0412\u0441\u0451 \u044D\u0442\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u044B\u0437\u043E\u0432
      \u0438\u0433\u0440\u043E\u043A\u0430\u043C, \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0434\u0443\u043C\u0430\u0442\u044C \u0438 \u0438\u0441\u043A\u0430\u0442\u044C
      \u043E\u0442\u0432\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 481521961000960
    m_Localized: "\u041A\u0430\u043A \u0442\u0430\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0431\u0438\u043E\u0438\u043D\u0436\u0435\u043D\u0435\u0440
      \u0410\u043D\u0430\u0442\u043E\u043B\u0438\u0439 \u041C\u0451\u0434\u0447\u0443\u0440\u0438\u043D? "
    m_Metadata:
      m_Items: []
  - m_Id: 481698868355072
    m_Localized: "\"\u0420\u0435\u0434\u0438\u0441\u043A\u0430 \u043D\u0435 \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442,
      \u0435\u0441\u043B\u0438 \u0442\u044F\u043D\u0443\u0442\u044C \u0435\u0451
      \u0438\u0437 \u0437\u0435\u043C\u043B\u0438, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442\"."
    m_Metadata:
      m_Items: []
  - m_Id: 481780791500800
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u043C\u043D\u0435 \u0442\u043E\u0436\u0435
      \u043D\u0443\u0436\u043D\u043E \u0434\u0430\u0442\u044C \u0441\u0435\u0431\u0435
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C
      \u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0432\u043F\u0435\u0440\u0451\u0434
      \u0441\u043B\u043E\u043C\u044F \u0433\u043E\u043B\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 481816275312640
    m_Localized: "\"\u0420\u0435\u0434\u0438\u0441\u043A\u0430 \u043D\u0435 \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442,
      \u0435\u0441\u043B\u0438 \u0442\u044F\u043D\u0443\u0442\u044C \u0435\u0451
      \u0438\u0437 \u0437\u0435\u043C\u043B\u0438, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442\"."
    m_Metadata:
      m_Items: []
  - m_Id: 482030218371072
    m_Localized: "\u0412\u0441\u0451 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F,
      \u0435\u0441\u043B\u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0443 \u0438\u0441\u043A\u0430\u0442\u044C
      \u043D\u043E\u0432\u044B\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438,
      \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u043E\u043A\u0430\u0436\u0443\u0442\u0441\u044F
      \u043D\u0435 \u0442\u0435\u043C\u0438, \u0447\u0442\u043E \u044F \u043E\u0436\u0438\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 482119632543744
    m_Localized: "\u042F-\u0442\u043E \u0434\u0443\u043C\u0430\u043B, \u0442\u044B
      \u0437\u0434\u0435\u0441\u044C \u0443\u0447\u0451\u043D\u044B\u0439, \u0430
      \u043D\u0435 \u043A\u0430\u0441\u043A\u0430\u0434\u0451\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 482166801686528
    m_Localized: " \u041F\u0440\u044B\u0433\u0430\u0442\u044C \u0432 \u043E\u0434\u043D\u0443
      \u0438 \u0442\u0443 \u0436\u0435 \u044F\u043C\u0443 \u0440\u0430\u0437 \u0437\u0430
      \u0440\u0430\u0437\u043E\u043C \u2014 \u044D\u0442\u043E, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u044C, \u043D\u043E \u043D\u0435
      \u043E\u0441\u043E\u0431\u043E \u0443\u043C\u043D\u043E, \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 482214822273024
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u0432\u043C\u0435\u0441\u0442\u043E
      \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0430\u0433\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0443\u0434\u0430\u0447\u0443, \u043D\u0430\u0447\u043D\u0451\u0448\u044C
      \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 482269629243392
    m_Localized: "\u041E\u043F\u044F\u0442\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 482318241226752
    m_Localized: "\u0425\u0438\u043C\u0438\u044F \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0440\u0430\u0441\u0441\u0443\u0434\u043A\u0430, \u0430 \u043D\u0435 \u0431\u0435\u0437\u0434\u0443\u043C\u043D\u043E\u0439
      \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 482411677736960
    m_Localized: "\u041D\u0443 \u0432\u043E\u0442, \u0441\u043D\u043E\u0432\u0430
      \u043D\u0430 \u0441\u0442\u0430\u0440\u0442\u0435. \u041C\u043E\u0436\u0435\u0442,
      \u0432 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 482450076590080
    m_Localized: "\u0425\u043E\u0442\u044F, \u0441 \u043C\u043E\u0438\u043C \u0432\u0435\u0437\u0435\u043D\u0438\u0435\u043C
      \u044D\u0442\u043E \u043F\u043E\u0434 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u043C...
      \u041B\u0430\u0434\u043D\u043E, \u043F\u043E\u0440\u0430 \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 482701189570560
    m_Localized: "\u0413\u0435\u0439\u043C-\u043E\u0432\u0435\u0440\u044B \u2014
      \u044D\u0442\u043E \u0442\u043E\u0436\u0435 \u0441\u043F\u043E\u0441\u043E\u0431
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F, \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 482755950403584
    m_Localized: "\u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435,
      \u0442\u044B \u0442\u043E\u0447\u043D\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0448\u044C,
      \u043A\u0430\u043A \u043D\u0435 \u043D\u0430\u0434\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 482804482695168
    m_Localized: "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u043D\u044F\u0442\u044C,
      \u043A\u0430\u043A \u043D\u0430\u0434\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 482873743237120
    m_Localized: "\u041F\u0430\u0448\u0430, \u0442\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
      \u0432\u044B\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0434\u043E\u043C \u0431\u0435\u0437
      \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430, \u0430 \u0443\u0441\u043F\u0435\u0445
      \u0432 \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u0435 \u0431\u0435\u0437
      \u0437\u043D\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 482922405552128
    m_Localized: "\u0423\u0447\u0438\u0441\u044C! \u0422\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430\u0443\u043A\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442
      \u0442\u0435\u0431\u044F \u043A \u043F\u043E\u0431\u0435\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 482960082984960
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0432\u0441\u0451
      \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 483005134004224
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u043F\u043E\u043D\u044F\u043B,
      \u0433\u0434\u0435 \u043E\u0448\u0438\u0431\u0441\u044F. \u0418\u043B\u0438
      \u043D\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 483064852504576
    m_Localized: "\u0412\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u044B
      \u0435\u0449\u0451 \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0432\u0441\u0435
      \u044D\u0442\u0438 \u0440\u0435\u0446\u0435\u043F\u0442\u044B \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 483146989559808
    m_Localized: "\u041F\u0430\u0448\u0430, \u0442\u044B \u043C\u0435\u043D\u044F
      \u0434\u0430\u0436\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0432\u043B\u0435\u043A\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 483194079010816
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u044C \u043D\u0430
      \u043E\u0434\u043D\u043E\u043C \u0438 \u0442\u043E\u043C \u0436\u0435 \u043C\u0435\u0441\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 483230049361920
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u043C\u043D\u0435 \u0434\u0430\u0442\u044C
      \u0442\u0435\u0431\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 483262924316672
    m_Localized: "\u0425\u043E\u0442\u044F... \u043D\u0435\u0442, \u044D\u0442\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u0440\u043E\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 483313612480512
    m_Localized: "\u041F\u0440\u043E\u0438\u0433\u0440\u044B\u0448 \u2014 \u044D\u0442\u043E
      \u0443\u0440\u043E\u043A, \u0435\u0441\u043B\u0438 \u0442\u044B \u0433\u043E\u0442\u043E\u0432
      \u0435\u0433\u043E \u0432\u044B\u0443\u0447\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 483353965879296
    m_Localized: "\u0414\u0430\u0432\u0430\u0439, \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u044C\u0441\u044F:
      \u0441\u0434\u0435\u043B\u0430\u0439 \u0443\u043F\u043E\u0440 \u043D\u0430
      \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 483393094541312
    m_Localized: "\u041E\u043D\u0438 \u0434\u0430\u0434\u0443\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0435
      \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 483449264660480
    m_Localized: "\u0421\u043D\u043E\u0432\u0430 \u0442\u0443\u0442. \u041D\u0443
      \u0447\u0442\u043E \u0436, \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u043D\u043E\u043C\u0435\u0440...
      \u043A\u0430\u043A\u0430\u044F \u0442\u0430\u043C \u0443\u0436\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 483488150052864
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u2014 \u043D\u0435
      \u0441\u0434\u0430\u0432\u0430\u0442\u044C\u0441\u044F, \u0432\u0435\u0434\u044C
      \u0434\u0430\u0436\u0435 \u0432\u0435\u043B\u0438\u043A\u0438\u0435 \u0445\u0438\u043C\u0438\u043A\u0438
      \u043D\u0435 \u0441\u0440\u0430\u0437\u0443 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0438
      \u043D\u043E\u0432\u044B\u0435 \u0437\u0430\u043A\u043E\u043D\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 483537059831808
    m_Localized: "\u0410 \u0432\u043E\u0442 \u0442\u0432\u043E\u044F \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C
      \u043F\u043E\u043A\u0430 \u043F\u043E\u0434 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 483610581786624
    m_Localized: "\u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0442\u0438\u0442\u0430\u043D
      \u2014 \u044D\u0442\u043E \u043C\u0435\u0442\u0430\u043B\u043B \u0441\u0442\u043E\u0439\u043A\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 483683743031296
    m_Localized: "\u0414\u0430\u0432\u0430\u0439, \u0443\u0434\u0438\u0432\u0438
      \u043C\u0435\u043D\u044F, \u0438\u043D\u0430\u0447\u0435 \u0442\u0430\u043A
      \u0438 \u0431\u0443\u0434\u0435\u043C \u0445\u043E\u0434\u0438\u0442\u044C
      \u043F\u043E \u043A\u0440\u0443\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 483750738649088
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0439 \u0432\u044B\u0432\u043E\u0434\u044B,
      \u041F\u0430\u0448\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 483814617899008
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0445\u0438\u043C\u0438\u043A \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u043E\u0448\u0438\u0431\u043A\u0443, \u043E\u043D \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442
      \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 483847937449984
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0438\u0433\u0440\u043E\u043A \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442...
      \u043D\u0443, \u0442\u044B \u043F\u043E\u043D\u044F\u043B, \u043A \u0447\u0435\u043C\u0443
      \u044F \u0432\u0435\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 483895152730112
    m_Localized: "\u041D\u0430\u0443\u043A\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F \u0438 \u0440\u0430\u0441\u0447\u0451\u0442\u043E\u0432,
      \u0430 \u043D\u0435 \u0438\u043D\u0442\u0443\u0438\u0442\u0438\u0432\u043D\u044B\u0445
      \u0442\u044B\u0447\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 483944020566016
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0432 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0445, \u0430 \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0445 \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043E\u0432\u044B\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 484006389866496
    m_Localized: "\u041B\u0430\u0434\u043D\u043E, \u041F\u0430\u0448\u0430, \u0445\u0432\u0430\u0442\u0438\u0442
      \u043D\u044B\u0442\u044C. \u0421\u043E\u0431\u0435\u0440\u0438\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 484068301987840
    m_Localized: "\u0415\u0441\u043B\u0438 \u044F \u0435\u0449\u0451 \u0440\u0430\u0437
      \u0443\u0441\u043B\u044B\u0448\u0443 \u043E\u0442 \u0410\u0440\u043D\u043E,
      \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u0438\u0433\u0440\u0430, \u0442\u043E\u0447\u043D\u043E \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0441\u043A\u0430\u0436\u0443 \u0432 \u043E\u0442\u0432\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 484701763526656
    m_Localized: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0442\u0430\u043A\u043E\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 484782445158400
    m_Localized: "\u042F \u043D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u0447\u0442\u043E \u043C\u043D\u0435 \u0441 \u043D\u0438\u043C \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 484812136636416
    m_Localized: "\u042D\u0442\u043E \u0447\u0430\u0441\u0442\u044C \u0442\u043E\u0433\u043E,
      \u0447\u0442\u043E \u0442\u044B \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0448\u044C
      \"\u0438\u0433\u0440\u043E\u0439\"."
    m_Metadata:
      m_Items: []
  - m_Id: 484840754372608
    m_Localized: "\u042F \u0441\u0430\u043C \u043D\u0435 \u043B\u044E\u0431\u043B\u044E
      \u0432\u0441\u0435 \u044D\u0442\u0438 \u0433\u043B\u0443\u043F\u043E\u0441\u0442\u0438,
      \u043D\u043E \u043A\u0430\u043A \u0431\u044B \u0442\u0430\u043C \u043D\u0438
      \u0431\u044B\u043B\u043E, \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B,
      \u041F\u0430\u0448\u0430, \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A, \u0434\u0430\u0436\u0435
      \u0432 \u044D\u0442\u043E\u0439 \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 484904298078208
    m_Localized: "\u042F \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u044D\u0442\u0438
      \u0442\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u044B\u0435
      \"\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F\" \u043C\u043E\u0433\u0443\u0442
      \u0441\u0442\u0430\u0442\u044C \u0442\u0432\u043E\u0438\u043C \u0442\u0443\u0437\u043E\u043C
      \u0432 \u0440\u0443\u043A\u0430\u0432\u0435, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u0432\u0441\u044E \u043D\u0435\u043B\u0435\u043F\u043E\u0441\u0442\u044C
      \u044D\u0442\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 484952209612800
    m_Localized: "\u0427\u0438\u0442\u0430\u0439 \u0440\u0435\u0446\u0435\u043F\u0442\u044B
      \u0438 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0439 \u043F\u043E \u043D\u0438\u043C
      \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 484991547990016
    m_Localized: "\u0422\u043E \u0435\u0441\u0442\u044C \u044D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043A\u0430\u043A \u043C\u0430\u0433\u0438\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 485025882562560
    m_Localized: "\u042F \u0432\u0441\u0451 \u0435\u0449\u0451 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u043A\u0430\u043A \u0432\u0441\u0435 \u044D\u0442\u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
      \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 485084250497024
    m_Localized: "\u041C\u0430\u0433\u0438\u044F? \u041D\u0435\u0442, \u041F\u0430\u0448\u0430.
      \u042D\u0442\u043E \u043D\u0435 \u043C\u0430\u0433\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 485151871066112
    m_Localized: "\u042D\u0442\u043E \u043D\u0430\u0443\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u043E\u0441\u0432\u043E\u0438\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C, \u043A\u0430\u043A
      \u044D\u0442\u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 485212612976640
    m_Localized: "\u0422\u044B \u0438 \u0441\u0430\u043C \u0432\u0441\u0451 \u0443\u0432\u0438\u0434\u0438\u0448\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\u0447\u043D\u0435\u0448\u044C \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 485265679310848
    m_Localized: "\u041D\u043E \u043F\u043E\u043A\u0430 \u044D\u0442\u043E \u043D\u0435
      \u0438\u043C\u0435\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
      \u0441\u043C\u044B\u0441\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 485302379470848
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C
      \u0433\u043E\u0442\u043E\u0432, \u0440\u0435\u0446\u0435\u043F\u0442 \u0442\u0435\u0431\u0435
      \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 485378602557440
    m_Localized: "\u0420\u0435\u0446\u0435\u043F\u0442 \u0434\u043B\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
      \u2014 \u044D\u0442\u043E \u0436\u0435 \u043A\u0430\u043A \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0444\u043E\u043B\u0438\u0430\u043D\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 485421636116480
    m_Localized: "\u041D\u0435\u0442, \u041F\u0430\u0448\u0430, \u044D\u0442\u043E
      \u043D\u0435 \u043C\u0430\u0433\u0438\u044F. \u042D\u0442\u043E \u043D\u0430\u0443\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 485458827010048
    m_Localized: "\u041A\u0430\u0436\u0434\u0430\u044F \u0444\u043E\u0440\u043C\u0443\u043B\u0430
      \u2014 \u044D\u0442\u043E \u043A\u043B\u044E\u0447 \u043A \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E
      \u043C\u0435\u0436\u0434\u0443 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 485521909342208
    m_Localized: "\u0410 \u0435\u0441\u043B\u0438 \u0443 \u043C\u0435\u043D\u044F
      \u043D\u0435\u0442 \u043D\u0443\u0436\u043D\u044B\u0445 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0443\u0436\u043D\u044B \u0432
      \u0440\u0435\u0446\u0435\u043F\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 485575353163776
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0438\u0449\u0438. \u0412 \u0445\u0438\u043C\u0438\u0438
      \u0432\u0441\u0451 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u044B\u0440\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 485610249773056
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0434\u0430\u0436\u0435 \u0440\u0435\u0434\u043A\u0438\u0439
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438,
      \u0435\u0441\u043B\u0438 \u0431\u044B\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 485718525730816
    m_Localized: "\u0421 \u044D\u0442\u0438\u043C\u0438 \u0440\u0435\u0446\u0435\u043F\u0442\u0430\u043C\u0438
      \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F
      \u0430\u043B\u0445\u0438\u043C\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 485761274077184
    m_Localized: "\u0410\u043B\u0445\u0438\u043C\u0438\u044F \u0431\u044B\u043B\u0430
      \u043F\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u0446\u0435\u0439
      \u0445\u0438\u043C\u0438\u0438. \u0422\u044B \u043D\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 485829922250752
    m_Localized: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447,
      \u0430 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0445\u0438\u043C\u0438\u0438
      \u0440\u0435\u0446\u0435\u043F\u0442\u044B \u0442\u0430\u043A \u0436\u0435
      \u043F\u0440\u043E\u0441\u0442\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 485870187569152
    m_Localized: "\u041F\u0430\u0448\u0430, \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439
      \u0445\u0438\u043C\u0438\u0438 \u0432\u0441\u0435 \u044D\u0442\u0438 \xAB\u0440\u0435\u0446\u0435\u043F\u0442\u044B\xBB
      \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0441\u043B\u043E\u0436\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 485902622121984
    m_Localized: "\u041D\u043E \u0441\u0443\u0442\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u0440\u0435\u0436\u043D\u0435\u0439 \u2014 \u043D\u0443\u0436\u043D\u043E
      \u0437\u043D\u0430\u0442\u044C \u043E\u0441\u043D\u043E\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 485932372320256
    m_Localized: "\u0418 \u0435\u0441\u043B\u0438 \u0442\u044B \u043D\u0430\u0443\u0447\u0438\u0448\u044C\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432 \u043A
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 485971584868352
    m_Localized: "\u041D\u043E \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439,
      \u0442\u0443\u0442 \u2014 \u0438\u0433\u0440\u0430, \u0430 \u043D\u0435 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 486051880624128
    m_Localized: "\u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u044F
      \u0438\u0437\u0443\u0447\u0430\u044E \u0440\u0435\u0446\u0435\u043F\u0442\u044B,
      \u0442\u0435\u043C \u043C\u0435\u043D\u044C\u0448\u0435 \u043E\u043D\u0438
      \u043C\u0435\u043D\u044F \u043F\u0443\u0433\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 486101457297408
    m_Localized: "\u0422\u044B \u0443\u0436\u0435 \u0432\u0438\u0434\u0438\u0448\u044C
      \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u0438,
      \u0430 \u043D\u0435 \u0445\u0430\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 486141848444928
    m_Localized: "\u0418\u043C\u0435\u043D\u043D\u043E \u044D\u0442\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442
      \u0443\u0447\u0451\u043D\u043E\u0433\u043E \u043E\u0442 \u043D\u043E\u0432\u0438\u0447\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 486207891955712
    m_Localized: "\u0423 \u043C\u0435\u043D\u044F \u0443\u0436\u0435 \u043E\u0447\u0435\u043D\u044C
      \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445
      \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 486260173955072
    m_Localized: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u044F \u0443\u0436\u0435 \u0437\u043D\u0430\u044E \u0432\u0441\u0451, \u0447\u0442\u043E
      \u043D\u0443\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 486309301837824
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0443\u0447\u0451\u043D\u044B\u0439
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \"\u042F \u0437\u043D\u0430\u044E \u0432\u0441\u0451\"."
    m_Metadata:
      m_Items: []
  - m_Id: 486342541697024
    m_Localized: "\u0412\u043C\u0435\u0441\u0442\u043E \u044D\u0442\u043E\u0433\u043E
      \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \"\u042F \u0433\u043E\u0442\u043E\u0432
      \u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435\"."
    m_Metadata:
      m_Items: []
  - m_Id: 486438192799744
    m_Localized: "\u042D\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C? \u0412\u0438\u0434\u0438\u043C\u043E
      \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0441\u043B\u043E\u0436\u043D\u0435\u0435
      \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 486504886427648
    m_Localized: "\u041A\u0430\u043A \u0438 \u0432 \u0445\u0438\u043C\u0438\u0438,
      \u043A\u0430\u0436\u0434\u044B\u0439 \u044D\u0442\u0430\u043F \u0441\u043B\u043E\u0436\u043D\u0435\u0435
      \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0433\u043E. \u0411\u0443\u0434\u044C
      \u0433\u043E\u0442\u043E\u0432 \u043A \u043D\u043E\u0432\u044B\u043C \u0432\u044B\u0437\u043E\u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 486553510993920
    m_Localized: "\u0422\u044B? \u0422\u044B \u0438 \u0435\u0441\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0431\u043E\u0441\u0441?!"
    m_Metadata:
      m_Items: []
  - m_Id: 486658301485056
    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E, \u041F\u0430\u0448\u0430.
      \u0422\u044B \u0434\u043E\u0448\u0451\u043B \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E
      \u043A\u043E\u043D\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 486725611675648
    m_Localized: "\u0410 \u043A\u0442\u043E \u0436\u0435 \u0435\u0449\u0451? \u0420\u0430\u0437\u0432\u0435
      \u0442\u044B \u043D\u0435 \u0434\u043E\u0433\u0430\u0434\u044B\u0432\u0430\u043B\u0441\u044F,
      \u0447\u0442\u043E \u0432\u0441\u0451 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u044F \u0433\u043E\u0442\u043E\u0432\u0438\u043B \u0442\u0435\u0431\u044F
      \u0438\u043C\u0435\u043D\u043D\u043E \u043A \u044D\u0442\u043E\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 486767328223232
    m_Localized: "\u0410\u0440\u043D\u043E, \u0442\u044B \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u043B
      \u0435\u0433\u043E, \u043A\u0430\u043A \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0443\u044E
      \u043C\u044B\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 486841525460992
    m_Localized: "\u041D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C, \u0441\u0442\u0430\u0440\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 486876531122176
    m_Localized: "\u042F \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u043B \u0435\u043C\u0443
      \u0432\u044B\u0437\u043E\u0432\u044B, \u0434\u0430\u0432\u0430\u043B \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438,
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B \u0443\u0447\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043E\u0448\u0438\u0431\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 486909565460480
    m_Localized: "\u0418 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u043A\u0430\u043A\u0438\u043C
      \u043E\u043D \u0441\u0442\u0430\u043B! \u0420\u0430\u0437\u0432\u0435 \u0442\u044B
      \u043D\u0435 \u0433\u043E\u0440\u0434\u0438\u0448\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 486941970653184
    m_Localized: "\u042F \u0433\u043E\u0442\u043E\u0432 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C
      \u0442\u0435\u0431\u044F \u0438 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0432\u0441\u0451 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u044F \u0431\u044B\u043B \u043D\u0435 \u0438\u0433\u0440\u0443\u0448\u043A\u043E\u0439
      \u0432 \u0442\u0432\u043E\u0438\u0445 \u0440\u0443\u043A\u0430\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 486986543521792
    m_Localized: "\u041E\u0434\u0438\u043D \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434
      \u043E\u0447\u043A\u043E\u0432 \u0442\u0435\u0431\u0435! \u0418\u043C\u0435\u043D\u043D\u043E
      \u044D\u0442\u043E\u0433\u043E \u044F \u0436\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 487026536210432
    m_Localized: "\u041D\u043E \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439,
      \u041F\u0430\u0448\u0430, \u044F \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0431\u043E\u0441\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 487080474959872
    m_Localized: "\u042F \u2014 \u0432\u043E\u043F\u043B\u043E\u0449\u0435\u043D\u0438\u0435
      \u0442\u0432\u043E\u0438\u0445 \u0437\u043D\u0430\u043D\u0438\u0439, \u0442\u0432\u043E\u0438\u0445
      \u043E\u0448\u0438\u0431\u043E\u043A \u0438 \u0442\u0432\u043E\u0438\u0445
      \u043F\u043E\u0431\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 487120417316864
    m_Localized: "\u041F\u0430\u0448\u0430, \u0432\u0441\u043F\u043E\u043C\u043D\u0438
      \u0432\u0441\u0451, \u0447\u0435\u043C\u0443 \u0442\u044B \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 487158417711104
    m_Localized: "\u0410\u0440\u043D\u043E \u0441\u0438\u043B\u0451\u043D, \u043D\u043E
      \u0438 \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043F\u0430\u0440\u0443
      \u043A\u043E\u0437\u044B\u0440\u0435\u0439 \u0432 \u0440\u0443\u043A\u0430\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 487210775207936
    m_Localized: "\u0425\u0430-\u0445\u0430, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C.
      \u041F\u0443\u0441\u0442\u044C \u043F\u043E\u0431\u0435\u0434\u0438\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 487320494006272
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u043C\u044B \u0443\u0436\u0435
      \u0434\u0430\u043B\u0435\u043A\u043E \u0437\u0430\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 487384712994816
    m_Localized: "\u0425\u0430, \u0438 \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430\u0447\u0430\u043B\u043E, \u041F\u0430\u0448\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 487423061516288
    m_Localized: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438: \u0433\u043B\u0430\u0432\u043D\u043E\u0435
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043E\u0439\u0442\u0438
      \u0434\u043E \u0444\u0438\u043D\u0438\u0448\u0430, \u0430 \u043F\u043E\u043D\u044F\u0442\u044C,
      \u043A\u0430\u043A \u0442\u044B \u0442\u0443\u0434\u0430 \u043F\u0440\u0438\u0448\u0451\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 487458931204096
    m_Localized: "\u0423 \u0441\u0430\u043C\u0443\u0440\u0430\u044F \u043D\u0435\u0442
      \u0446\u0435\u043B\u0438, \u0435\u0441\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0443\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 487494888972288
    m_Localized: "\u0425\u0430-\u0445\u0430! \u042F \u043F\u043E\u0433\u043B\u044F\u0436\u0443,
      \u043B\u044E\u0434\u0441\u043A\u0430\u044F \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430
      \u0442\u0435\u0431\u0435 \u043D\u0435 \u0447\u0443\u0436\u0434\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 487573574115328
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E, \u0410\u0440\u043D\u043E, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u044F \u043F\u043E\u0431\u0435\u0434\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 487650225020928
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u0442\u044B \u0440\u0435\u0448\u0438\u043B \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u044D\u0442\u0443 \u0438\u0433\u0440\u0443, \u044D\u0442\u043E\u0442 \u043C\u0438\u0440
      \u0441 \u0445\u0438\u043C\u0438\u0435\u0439 \u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 487687554326528
    m_Localized: "\u041C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
      \u0447\u0442\u043E-\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 487719095492608
    m_Localized: "\u041D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0443\u0447\u0438\u0442\u044C
      \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439 \u0445\u0438\u043C\u0438\u0438,
      \u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E
      \u043E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043D\u0435 \u0442\u0430\u043A\u043E\u0439 \u0443\u0436 \u0441\u043A\u0443\u0447\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 488013569187840
    m_Localized: "\u0418\u0433\u0440\u044B \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0443\u0447\u0438\u0442\u044C
      \u043D\u0430\u0441, \u043A\u0430\u043A \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0435 \u0432\u0435\u0449\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 488045781442560
    m_Localized: "\u0425\u0438\u043C\u0438\u044F \u2014 \u044D\u0442\u043E \u043D\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0431\u043E\u0440 \u0440\u0435\u0430\u043A\u0446\u0438\u0439,
      \u044D\u0442\u043E \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 488094129184768
    m_Localized: "\u0410 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E \u2014
      \u044D\u0442\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 488127192883200
    m_Localized: "\u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E, \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 488168557109248
    m_Localized: "\u042F \u0434\u0443\u043C\u0430\u043B, \u0445\u0438\u043C\u0438\u044F
      \u2014 \u044D\u0442\u043E \u0442\u043E\u0447\u043D\u0430\u044F \u043D\u0430\u0443\u043A\u0430,
      \u0430 \u0442\u0443\u0442... \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0438 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0435
      \u0440\u0435\u0430\u043A\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 488212727324672
    m_Localized: "\u041D\u0443, \u0442\u044B \u0432\u0435\u0434\u044C \u0441\u0430\u043C
      \u0443\u0436\u0435 \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u043D\u0435
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C
      \u0442\u043E\u0447\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 488249238740992
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0432\u0430\u0436\u043D\u043E
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C, \u043A\u0430\u043A
      \u044D\u0442\u043E \u0432\u0441\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 488281677488128
    m_Localized: "\u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043E\u0440\u0438\u044E,
      \u043D\u043E \u0438 \u043A\u0430\u043A \u044D\u0442\u043E \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 488319002599424
    m_Localized: "\u041F\u043E\u043D\u0438\u043C\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 488352095657984
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0432\u0441\u0451 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0435 \u0442\u0430\u043A \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E,
      \u043A\u0430\u043A \u043A\u0430\u0436\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 488385293574144
    m_Localized: "\u0418\u043C\u0435\u043D\u043D\u043E. \u0418 \u0442\u044B \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F
      \u044D\u0442\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 488420341178368
    m_Localized: "\u042F \u0433\u043E\u0440\u0436\u0443\u0441\u044C, \u0447\u0442\u043E
      \u0441\u043C\u043E\u0433 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0442\u0435\u0431\u044F \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C
      \u043D\u0430 \u0445\u0438\u043C\u0438\u044E \u0441 \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0443\u0433\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 488498225209344
    m_Localized: "\u041D\u043E \u043F\u043E\u043C\u043D\u0438, \u041F\u0430\u0448\u0430,
      \u0447\u0442\u043E \u0432\u0441\u0451, \u0447\u0435\u043C\u0443 \u0442\u044B
      \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F, \u2014 \u044D\u0442\u043E
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0447\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 488549576073216
    m_Localized: "\u041C\u0438\u0440 \u0445\u0438\u043C\u0438\u0438 \u0433\u043E\u0440\u0430\u0437\u0434\u043E
      \u0448\u0438\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 488598129336320
    m_Localized: "\u042F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u0447\u0442\u043E \u0438\u0433\u0440\u044B \u043C\u043E\u0433\u0443\u0442
      \u0431\u044B\u0442\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 488663195574272
    m_Localized: "\u041D\u043E \u0432\u0441\u0451 \u0436\u0435 \u0445\u0438\u043C\u0438\u044F
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u0431\u0430\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 488723828432896
    m_Localized: "\u041E\u043D\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0433\u043E
      \u043F\u043E\u0434\u0445\u043E\u0434\u0430, \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 488769600872448
    m_Localized: "\u041E\u0434\u043D\u0430\u043A\u043E, \u043A\u0430\u043A \u0442\u044B,
      \u041F\u0430\u0448\u0430, \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B, \u0438\u043D\u043E\u0433\u0434\u0430
      \u0432\u0430\u0436\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u0432\u0435\u0449\u0438 \u043F\u043E\u0434 \u0440\u0430\u0437\u043D\u044B\u043C
      \u0443\u0433\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 488823908720640
    m_Localized: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438\u043C\u0435\u043D\u043D\u043E
      \u0432 \u044D\u0442\u043E\u043C \u0435\u0441\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0438\u0441\u0442\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 488870427746304
    m_Localized: "\u0414\u0430, \u044F \u0434\u0443\u043C\u0430\u044E, \u0442\u0435\u043F\u0435\u0440\u044C
      \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 488915021586432
    m_Localized: "\u041D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u0441\u0451
      \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u044B\u043C
      \u0438 \u0442\u043E\u0447\u043D\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 488964866695168
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0432\u0430\u0436\u043D\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 489012321050624
    m_Localized: "\u0417\u0430\u0431\u0430\u0432\u043D\u043E \u0442\u044B \u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u0443\u0435\u0448\u044C
      \u043C\u044B\u0441\u043B\u0438, \u041F\u0430\u0448\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 489059137871872
    m_Localized: "\u0415\u0441\u0442\u044C \u043C\u0443\u0434\u0440\u043E\u0435 \u0437\u0435\u0440\u043D\u043E
      \u0432 \u0442\u0432\u043E\u0435\u0439 \u0447\u0435\u0440\u0435\u043F\u0443\u0448\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 489103119343616
    m_Localized: "\u0412\u0430\u0436\u043D\u043E \u0432\u0438\u0434\u0435\u0442\u044C
      \u043E\u0431\u0449\u0443\u044E \u043A\u0430\u0440\u0442\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 489153262247936
    m_Localized: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0442\u044B
      \u043F\u0440\u0430\u0432, \u0410\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 489198925635584
    m_Localized: "\u041D\u043E, \u041F\u0430\u0448\u0430, \u044F \u043D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0442\u044B \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430
      \u0438 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u2014 \u0432\u043E\u0442
      \u0447\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u0430\u0436\u043D\u043E \u0432 \u043B\u044E\u0431\u043E\u0439 \u043D\u0430\u0443\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 489246749089792
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442
