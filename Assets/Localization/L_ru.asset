  - m_Id: 357202337456128
    m_Localized: "\u041A\u0430\u043B\u044C\u0446\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 357318297378816
    m_Localized: "\u041C\u0430\u0440\u0433\u0430\u043D\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 462015448473600
    m_Localized: "\u041E\u0433\u043E, \u044D\u0442\u043E \u0447\u0442\u043E, \u0431\u043E\u0439?
      \u041A\u0430\u043A \u0432 \u043C\u043E\u0438\u0445 \u043B\u044E\u0431\u0438\u043C\u044B\u0445
      \u043A\u0430\u0440\u0442\u043E\u0447\u043D\u044B\u0445 \u0438\u0433\u0440\u0430\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 462219476197376
    m_Localized: "\u0411\u043E\u0439? \u042D\u0442\u043E \u0432\u0441\u0435\u0433\u043E
      \u043B\u0438\u0448\u044C \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442.
      \u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u043F\u043E\u043D\u044F\u0442\u044C
      \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432
      \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u0445 \u043F\u0440\u043E\u0442\u0438\u0432 \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 462308525465600
    m_Localized: "\u042D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442?!
      \u0414\u0430 \u0443 \u043D\u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430
      \u0433\u043E\u0440\u044F\u0442, \u043A\u0430\u043A \u0443 \u0431\u043E\u0441\u0441\u0430
      \u0440\u0435\u0439\u0434\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 462461382680576
    m_Localized: "\u041D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0439\u0441\u044F.
      \u042D\u0442\u043E \u0442\u0432\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0431\u043E\u0439, \u0438 \u043E\u043D \u043F\u043E\u043A\u0430\u0436\u0435\u0442,
      \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044B \u0433\u043E\u0442\u043E\u0432
      \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u043C\u043E\u0438 \u0441\u043E\u0432\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 462565384642560
    m_Localized: "\u041D\u0443-\u043D\u0443, \u0441\u0435\u0439\u0447\u0430\u0441
      \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u043C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 462830229774336
    m_Localized: "\u042D\u0442\u043E\u0442 \u0432\u0440\u0430\u0433 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E. \u0423 \u043C\u0435\u043D\u044F
      \u0435\u0441\u0442\u044C \u0448\u0430\u043D\u0441\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 463085729996800
    m_Localized: "\u0428\u0430\u043D\u0441\u044B \u0435\u0441\u0442\u044C \u0432\u0441\u0435\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 463125781405696
    m_Localized: "\u0425\u0438\u043C\u0438\u044F \u0443\u0447\u0438\u0442 \u043D\u0430\u0441,
      \u0447\u0442\u043E \u0434\u0430\u0436\u0435 \u0441\u043B\u0430\u0431\u044B\u0435
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u043C\u043E\u0433\u0443\u0442
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u0438\u043B\u0443 \u0432
      \u043D\u0443\u0436\u043D\u043E\u043C \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 463217259175936
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u0440\u0430\u0433\u0438
      \u0442\u0430\u043A\u0438\u0435 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B\u0435?
      \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u0443 \u043D\u0438\u0445 \u043D\u0435\u0442
      \u0434\u0440\u0443\u0433\u0438\u0445 \u0434\u0435\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 463290571415552
    m_Localized: "\u042D\u0442\u043E \u0447\u0430\u0441\u0442\u044C \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438,
      \u041F\u0430\u0448\u0430. \u041A\u0430\u043A \u043A\u0430\u0442\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440
      \u0432 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0440\u0435\u0430\u043A\u0446\u0438\u0438,
      \u043E\u043D\u0438 \u043F\u043E\u0434\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u044E\u0442
      \u0442\u0435\u0431\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 463602468249600
    m_Localized: "\u0423\u0444, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0442\u044C
      \u043A \u044D\u0442\u0438\u043C \u0431\u0438\u0442\u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 463674371203072
    m_Localized: "\u041F\u0440\u0438\u0432\u044B\u0447\u043A\u0430 \u2014 \u044D\u0442\u043E
      \u0445\u043E\u0440\u043E\u0448\u043E. \u041D\u043E \u043D\u0435 \u0442\u0435\u0440\u044F\u0439
      \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044E. \u0412
      \u0445\u0438\u043C\u0438\u0438 \u043D\u0435\u0434\u043E\u043E\u0446\u0435\u043D\u0451\u043D\u043D\u044B\u0439
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u043C\u043E\u0436\u0435\u0442 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u044C
      \u0432\u0441\u044E \u0440\u0435\u0430\u043A\u0446\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 464014231461888
    m_Localized: "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0431\u043E\u0439...
      \u042D\u0442\u043E\u0442 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 464100764147712
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u043E.
      \u0422\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0432\u0440\u0430\u0433\u0438
      \u0431\u0443\u0434\u0443\u0442 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E
      \u043D\u043E\u0432\u044B\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 464136113741824
    m_Localized: "\u041D\u0435\u0442, \u041F\u0430\u0448\u0430. \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u2014 \u044D\u0442\u043E
      \u0443\u043C\u0435\u043D\u0438\u0435 \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0432\u0430\u0442\u044C
      \u0441\u0442\u0430\u0440\u044B\u0435 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F
      \u0438\u043D\u0430\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 464225460805632
    m_Localized: "\u042D\u0442\u043E\u0442 \u0432\u0440\u0430\u0433 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 464279152091136
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u0432\u0440\u0430\u0433\u0438
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442 \u043C\u043D\u0435
      \u0440\u0435\u0434\u043A\u0438\u0435 \u0438\u0437\u043E\u0442\u043E\u043F\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 464318171701248
    m_Localized: "\u041E\u043D\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F
      \u0440\u0435\u0434\u043A\u043E, \u043D\u043E \u043C\u043E\u0433\u0443\u0442
      \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u043A\u043E\u0432\u0430\u0440\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 464389357428736
    m_Localized: "\u0427\u0435\u043C \u0434\u0430\u043B\u044C\u0448\u0435, \u0442\u0435\u043C
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0432\u0440\u0430\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 464447108800512
    m_Localized: "\u0422\u0430\u043A\u043E\u0432 \u0437\u0430\u043A\u043E\u043D \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430.
      \u0412 \u0445\u0438\u043C\u0438\u0438, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0442\u044C
      \u0441\u0438\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435,
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0435
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 464499386605568
    m_Localized: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447,
      \u0432\u044B \u0442\u043E\u0436\u0435 \u0445\u043E\u0442\u0438\u0442\u0435
      \u0438\u0445 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 464601677291520
    m_Localized: "\u042F \u0445\u0438\u043C\u0438\u043A, \u0430 \u043D\u0435 \u0432\u043E\u0438\u043D.
      \u041D\u043E \u0435\u0441\u043B\u0438 \u043F\u043E\u0431\u0435\u0434\u0430
      \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442 \u043D\u0430\u0441 \u043A
      \u0432\u044B\u0445\u043E\u0434\u0443, \u044F \u0433\u043E\u0442\u043E\u0432
      \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u0442\u044C \u0443\u0441\u0438\u043B\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 464660821172224
    m_Localized: "\u0418 \u0441\u043D\u043E\u0432\u0430 \u0432 \u0431\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 464891902156800
    m_Localized: "\u042D\u0442\u043E\u0442 \u0432\u0440\u0430\u0433 \u043C\u043D\u0435
      \u0443\u0436\u0435 \u0437\u043D\u0430\u043A\u043E\u043C. \u041D\u0430\u0434\u043E
      \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
      \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 464947837394944
    m_Localized: "\u041E, \u041F\u0430\u0448\u0430, \u0442\u044B \u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0432\u0441\u0451 \u044D\u0442\u043E \u2014 \u0447\u0430\u0441\u0442\u044C
      \u0438\u0433\u0440\u044B. \u0410 \u0438\u0441\u0442\u0438\u043D\u043D\u0430\u044F
      \u0438\u0433\u0440\u0430 \u043D\u0435 \u0434\u0430\u0451\u0442 \u0442\u0435\u0431\u0435
      \u0433\u043E\u0442\u043E\u0432\u044B\u0445 \u0440\u0435\u0448\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 464996403240960
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0441\u0430\u043C\u043E\u043C\u0443
      \u043D\u0430\u0439\u0442\u0438 \u0441\u0432\u043E\u0439 \u043F\u0443\u0442\u044C,
      \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442,
      \u0447\u0442\u043E \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u043B\u043E\u043C\u0430\u0442\u044C
      \u0441\u0442\u0430\u0440\u044B\u0435 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 465044423827456
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C?
      \u0422\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0439\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0436\u0438\u0437\u043D\u044C, \u043D\u0435
      \u043F\u043E\u043D\u0438\u043C\u0430\u044F \u043E\u0441\u043D\u043E\u0432\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 465104649838592
    m_Localized: "\u0411\u0435\u0437 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u0437\u043D\u0430\u043D\u0438\u0439, \u0431\u0435\u0437 \u0442\u0435\u043E\u0440\u0438\u0438,
      \u0442\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u0432\u0440\u0430\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 465167828639744
    m_Localized: "\u0410\u0445 \u0434\u0430, \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0442\u0435\u043E\u0440\u0438\u044F... \u041D\u043E \u041F\u0430\u0448\u0430,
      \u0442\u044B \u0432\u0435\u0434\u044C \u043D\u0435 \u0445\u043E\u0447\u0435\u0448\u044C
      \u0431\u044B\u0442\u044C \u0442\u0430\u043A\u0438\u043C, \u043A\u0430\u043A
      \u0414\u043C\u0438\u0442\u0440\u0438\u0439, \u0437\u0430\u0441\u0442\u0440\u044F\u0432\u0448\u0438\u043C
      \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C, \u0432\u0435\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 465219355664384
    m_Localized: "\u041B\u0443\u0447\u0448\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
      \u043D\u0430\u0439\u0442\u0438 \u0441\u0432\u043E\u0439 \u043F\u0443\u0442\u044C
      \u0438 \u0432\u044B\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0437\u0430
      \u0440\u0430\u043C\u043A\u0438 \u0441\u0442\u0430\u0440\u044B\u0445 \u043C\u0435\u0442\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 465290344259584
    m_Localized: "\u042F \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u043A\u0430\u043A
      \u0441\u0442\u0430\u0440\u044B\u0445 \u043C\u0435\u0442\u043E\u0434\u043E\u0432,
      \u0442\u0430\u043A \u0438 \u043D\u043E\u0432\u044B\u0445. \u0414\u0443\u043C\u0430\u044E,
      \u043C\u043E\u0436\u043D\u043E \u043A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 465388641968128
    m_Localized: "\u042D\u0442\u0438 \u0431\u0438\u0442\u0432\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
      \u0447\u0430\u0441\u0442\u044C\u044E \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 465453553016832
    m_Localized: "\u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441. \u0422\u044B \u0438\u0434\u0451\u0448\u044C
      \u0432\u043F\u0435\u0440\u0451\u0434, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
      \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0448\u044C \u044D\u0442\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 465573505916928
    m_Localized: "\u042F \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C.
      \u0418 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
      \u0445\u0438\u043C\u0438\u044F \u2014 \u044D\u0442\u043E \u043A\u0430\u043A
      \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 465646465835008
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0441 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 465701440577536
    m_Localized: "\u0412\u0441\u0435 \u043C\u044B \u043F\u043E-\u0441\u0432\u043E\u0435\u043C\u0443
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B, \u043D\u043E \u0432\u0441\u0451
      \u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u043C \u0432
      \u043E\u0434\u043D\u043E\u043C \u043C\u0438\u0440\u0435 \u0438 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u043C
      \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 465779534323712
    m_Localized: "\u041E\u0434\u0438\u043D \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434
      \u043E\u0447\u043A\u043E\u0432 \u0442\u0435\u0431\u0435, \u041F\u0430\u0448\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 465819468292096
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u044D\u043B\u0435\u043C\u0435\u043D\u0442
      \u0432 \u0441\u0432\u043E\u0451\u043C \u0440\u043E\u0434\u0435 \u0443\u043D\u0438\u043A\u0430\u043B\u0435\u043D.
      \u0418 \u0442\u044B \u043F\u0440\u0430\u0432, \u043E\u043D\u0438 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442
      \u0438 \u0432\u043B\u0438\u044F\u044E\u0442 \u0434\u0440\u0443\u0433 \u043D\u0430
      \u0434\u0440\u0443\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 465857728733184
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u0439 \u043E \u0440\u0435\u0430\u043A\u0446\u0438\u0438
      \u043C\u0435\u0436\u0434\u0443 \u043C\u0435\u0442\u0430\u043B\u043B\u0430\u043C\u0438
      \u0438 \u043D\u0435\u043C\u0435\u0442\u0430\u043B\u043B\u0430\u043C\u0438,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043C\u043E\u043B\u0435\u043A\u0443\u043B\u044B
      \u043C\u043E\u0433\u0443\u0442 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0442\u044C\u0441\u044F
      \u0438 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 466211035930624
    m_Localized: "\u041C\u044B \u0432\u0441\u0435 \u0440\u0430\u0437\u043D\u044B\u0435,
      \u043D\u043E \u0432 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043C\u043E\u043C\u0435\u043D\u0442
      \u0434\u043E\u043B\u0436\u043D\u044B \u043D\u0430\u0439\u0442\u0438 \u043E\u0431\u0449\u0438\u0439
      \u044F\u0437\u044B\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 466470927589376
    m_Localized: "\u0422\u043E\u0447\u043D\u043E \u0442\u0430\u043A \u0436\u0435,
      \u043A\u0430\u043A \u0438 \u0432 \u043B\u044E\u0431\u043E\u043C \u0440\u0430\u0437\u0432\u0438\u0442\u043E\u043C
      \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
      \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 466711324123136
    m_Localized: "\u042D\u0442\u043E \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      \u0441\u043B\u043E\u0436\u043D\u043E, \u043D\u043E \u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 466782161723392
    m_Localized: "\u041A\u0430\u043A \u0436\u0435 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043F\u043E\u043D\u044F\u0442\u044C, \u043A\u0430\u043A\u0438\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u0431\u0443\u0434\u0443\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435, \u0430 \u043A\u0430\u043A\u0438\u0435
      \u043F\u0440\u0438\u0432\u0435\u0434\u0443\u0442 \u043A \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 466839523024896
    m_Localized: "\u0412\u043E\u0442 \u0438\u043C\u0435\u043D\u043D\u043E \u0432
      \u044D\u0442\u043E\u043C \u0438 \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
      \u0432\u0435\u0441\u044C \u0441\u043C\u044B\u0441\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 466914596872192
    m_Localized: "\u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u0438\u0437\u0443\u0447\u0430\u0442\u044C,
      \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C
      \u0438\u0445 \u043F\u0440\u0438\u0440\u043E\u0434\u0443. \u0417\u043D\u0430\u043D\u0438\u044F
      \u2014 \u0432\u043E\u0442 \u043A\u043B\u044E\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 466968057470976
    m_Localized: "\u041D\u043E \u043F\u043E\u043C\u043D\u0438, \u0438\u043D\u043E\u0433\u0434\u0430
      \u0432\u0430\u0436\u043D\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u043D\u0430\u0442\u044C, \u043A\u0430\u043A \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442, \u0430 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C,
      \u043A\u0430\u043A \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u0432\u043B\u0438\u044F\u0442\u044C
      \u0434\u0440\u0443\u0433 \u043D\u0430 \u0434\u0440\u0443\u0433\u0430 \u0432
      \u0441\u0430\u043C\u044B\u0439 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 467035078254592
    m_Localized: "\u042F \u043F\u043E\u043D\u044F\u043B. \u042D\u0442\u043E \u043A\u0430\u043A
      \u0438 \u0432 \u0436\u0438\u0437\u043D\u0438 \u2014 \u043D\u0443\u0436\u043D\u043E
      \u0438\u0441\u043A\u0430\u0442\u044C \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u044E,
      \u043D\u043E \u0431\u044B\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u044B\u043C
      \u043A \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0432\u0441\u0451 \u0431\u0443\u0434\u0435\u0442 \u0438\u0434\u0442\u0438
      \u043F\u043E \u043F\u043B\u0430\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 467077495250944
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u041F\u0430\u0448\u0430.
      \u0422\u044B \u0433\u043E\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 467162861920256
    m_Localized: "\u041D\u043E \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C
      \u0442\u044B \u0440\u0435\u0448\u0438\u0448\u044C, \u043A\u0430\u043A \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441 \u044D\u0442\u0438\u043C \u043C\u0438\u0440\u043E\u043C, \u0442\u0435\u0431\u0435
      \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u043E\u0439\u0442\u0438
      \u0435\u0449\u0451 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 468022786514944
    m_Localized: "\u041E\u0433\u043E! \u042D\u0442\u043E \u0436\u0435 \u0446\u0435\u043B\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440 \u043A\u0430\u0440\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 468141418209280
    m_Localized: "\u041A\u0430\u043A \u0432\u044B\u0431\u0440\u0430\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043E\u0448\u0438\u0431\u0438\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 468223328772096
    m_Localized: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438, \u041F\u0430\u0448\u0430,
      \u0432\u0430\u0436\u043D\u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u0438\u043B\u0430 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430,
      \u043D\u043E \u0438 \u0435\u0433\u043E \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 469108092035072
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0441\u0430\u043C\u044B\u0439
      \u043D\u0435\u043F\u0440\u0438\u043C\u0435\u0442\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440
      \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0440\u0435\u0448\u0430\u044E\u0449\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 469194326925312
    m_Localized: "\u0412\u043E\u0442 \u044D\u0442\u043E \u0434\u0430! \u041F\u043E\u0447\u0435\u043C\u0443
      \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 469255224025088
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0432\u0441\u0451
      \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0432\u0437\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 469295233490944
    m_Localized: "\u0416\u0430\u0434\u043D\u043E\u0441\u0442\u044C \u2014 \u043F\u043B\u043E\u0445\u043E\u0439
      \u0441\u043E\u0432\u0435\u0442\u0447\u0438\u043A, \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u043C\u0435\u0434\u0432\u0435\u0434\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 469389634691072
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u0439, \u043A\u0430\u043A
      \u044D\u0442\u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u043F\u043E\u043C\u043E\u0433\u0443\u0442
      \u0442\u0435\u0431\u0435 \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u0432\u044B\u0438\u0433\u0440\u044B\u0448
      \u043D\u0435 \u0432 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435,
      \u0430 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 469444735262720
    m_Localized: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447,
      \u0441\u043A\u0430\u0436\u0438\u0442\u0435 \u0447\u0435\u0441\u0442\u043D\u043E,
      \u0432\u044B \u0431\u044B \u0447\u0442\u043E \u0432\u044B\u0431\u0440\u0430\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 469501651968000
    m_Localized: "\u042F? \u041D\u0443, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u044F \u0431\u044B \u0432\u044B\u0431\u0440\u0430\u043B \u0442\u043E, \u0447\u0442\u043E
      \u0441\u043B\u0443\u0436\u0438\u0442 \u0434\u0435\u043B\u0443 \u043D\u0430\u0443\u043A\u0438,
      \u0438\u0431\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0443\u043A\u0430
      \u0438\u043C\u0435\u0435\u0442 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 469561294970880
    m_Localized: "\u042D\u0442\u043E \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E,
      \u041F\u0430\u0448\u0430. \u0422\u044B \u0436\u0435 \u043D\u0435 \u0445\u043E\u0447\u0435\u0448\u044C
      \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F \u043D\u0430
      \u0447\u0442\u043E-\u0442\u043E \u043F\u0443\u0441\u0442\u043E\u0435, \u043D\u0435
      \u0442\u0430\u043A \u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 469674683785216
    m_Localized: "\u041D\u043E, \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u044D\u0442\u043E \u0442\u0432\u043E\u044F \u0438\u0433\u0440\u0430, \u0442\u0432\u043E\u0439
      \u0432\u044B\u0431\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 469721987145728
    m_Localized: "\u042F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0442\u0435\u0431\u0435
      \u043F\u043E\u043C\u043E\u0433\u0443, \u043D\u043E \u0442\u044B \u0441\u0430\u043C
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
      \u043B\u0443\u0447\u0448\u0435 \u0431\u044B \u0442\u044B \u0432\u044B\u0431\u0440\u0430\u043B
      \u043F\u0443\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
      \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u043C \u043D\u0430\u0443\u0447\u043D\u044B\u043C
      \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0430\u043C, \u0430 \u043D\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 469809413218304
    m_Localized: "\u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u044F \u0443\u0432\u0435\u0440\u0435\u043D,
      \u0447\u0442\u043E \u0442\u044B \u043F\u0440\u0438\u043C\u0435\u0448\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435,
      \u0440\u0430\u0437\u0443\u043C\u0435\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 470079455092736
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u044D\u0442\u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u0442\u0430\u043A\u0438\u043C\u0438
      \u0440\u0430\u0437\u043D\u044B\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 470177983488000
    m_Localized: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430
      \u0441\u0432\u043E\u0439 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 470216864686080
    m_Localized: "\u0412\u043E\u0442, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u041D\u0430\u0442\u0440\u0438\u0439 \u0431\u0443\u0440\u043D\u043E \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442,
      \u0430 \u0413\u0435\u043B\u0438\u0439 \u2014 \u043D\u0435\u0432\u043E\u0437\u043C\u0443\u0442\u0438\u043C
      \u0438 \u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 470251698380800
    m_Localized: "\u0423\u0437\u043D\u0430\u0439 \u0438\u0445 \u043F\u043E\u0431\u043B\u0438\u0436\u0435,
      \u0438 \u0432\u044B\u0431\u043E\u0440 \u0441\u0442\u0430\u043D\u0435\u0442
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 470315867037696
    m_Localized: "\u0421\u043D\u043E\u0432\u0430 \u043A\u0430\u0440\u0442\u044B,
      \u041F\u0430\u0448\u0430? \u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439
      \u0432\u044B\u0431\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 470361647865856
    m_Localized: "\u041D\u043E \u043F\u043E\u043C\u043D\u0438, \u0434\u0430\u0436\u0435
      \u0441\u0430\u043C\u044B\u0435 \u043C\u0435\u043B\u043A\u0438\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u043C\u043E\u0433\u0443\u0442 \u0443\u0434\u0438\u0432\u0438\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 470401816715264
    m_Localized: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A\u0438\u0435
      \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438 \u0431\u0443\u0434\u0443\u0442
      \u043D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 470498671583232
    m_Localized: "\u0425\u0430-\u0445\u0430. \u0412\u0441\u0451 \u0437\u0430\u0432\u0438\u0441\u0438\u0442
      \u043E\u0442 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0442\u044B \u0438\u0445
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 470572742991872
    m_Localized: "\u0411\u0443\u0434\u044C \u0433\u043E\u0442\u043E\u0432 \u043A
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 470657082056704
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0443 \u0437\u043E\u043B\u043E\u0442\u0430
      \u0442\u0430\u043A\u043E\u0439 \u043A\u0440\u0443\u0442\u043E\u0439 \u0432\u0438\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 470721317822464
    m_Localized: "\u0410\u0445, \u041F\u0430\u0448\u0430, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u044D\u0442\u043E \u0437\u043E\u043B\u043E\u0442\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 470759687315456
    m_Localized: "\u0412 \u0438\u0433\u0440\u0430\u0445 \u043E\u043D\u043E \u0432\u0441\u0435\u0433\u0434\u0430
      \u0441\u0438\u044F\u0435\u0442, \u043C\u0430\u043D\u0438\u0442 \u0438 \u043A\u0440\u0438\u0447\u0438\u0442:
      \"\u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u0435\u043D\u044F, \u044F \u0441\u0430\u043C\u044B\u0439
      \u0446\u0435\u043D\u043D\u044B\u0439!\"."
    m_Metadata:
      m_Items: []
  - m_Id: 470797926785024
    m_Localized: "\u0412 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u0437\u043E\u043B\u043E\u0442\u043E \u2014 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u043C\u0435\u0442\u0430\u043B\u043B,
      \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439, \u043D\u043E \u043D\u0435
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 470835784572928
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0441\u0430\u043C\u044B\u0435
      \u0442\u0443\u0441\u043A\u043B\u044B\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0432 \u0441\u0435\u0431\u0435
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u0441\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 470894844567552
    m_Localized: "\u0427\u0435\u043C \u0434\u043E\u043B\u044C\u0448\u0435 \u0441\u043C\u043E\u0442\u0440\u044E
      \u043D\u0430 \u043D\u0438\u0445, \u0442\u0435\u043C \u0441\u043B\u043E\u0436\u043D\u0435\u0435
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 470941678166016
    m_Localized: "\u0421\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u2014 \u044D\u0442\u043E
      \u043F\u0443\u0442\u044C \u043A \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 470976105013248
    m_Localized: "\u0422\u044B \u0443\u0436\u0435 \u043D\u0435 \u0442\u0430\u043A
      \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0438\u0432\u0435\u043D, \u043A\u0430\u043A
      \u0432 \u043D\u0430\u0447\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 471010376671232
    m_Localized: "\u042F \u0431\u044B \u0434\u0430\u0436\u0435 \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u0443\u0447\u0438\u0448\u044C\u0441\u044F \u043C\u044B\u0441\u043B\u0438\u0442\u044C,
      \u043A\u0430\u043A \u0445\u0438\u043C\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 471193395126272
    m_Localized: "\u0412\u043E\u0442 \u0438 \u0441\u043D\u043E\u0432\u0430 \u0432\u044B\u0431\u043E\u0440
      \u043A\u0430\u0440\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 471258738188288
    m_Localized: "\u0427\u0435\u0441\u0442\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044F,
      \u043F\u043E\u0440\u043E\u0439 \u044F \u0434\u0430\u0436\u0435 \u043D\u0435
      \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u043A\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E
      \u044D\u0442\u043E \u0432\u0441\u0451 \u0441\u0432\u044F\u0437\u0430\u043D\u043E
      \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0445\u0438\u043C\u0438\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 471299368411136
    m_Localized: "\u0412\u043E\u0442 \u0432 \u044D\u0442\u043E\u043C \u0438 \u0432\u0441\u044F
      \u0441\u0443\u0442\u044C, \u041F\u0430\u0448\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 471344041943040
    m_Localized: "\u0425\u0438\u043C\u0438\u044F \u2014 \u044D\u0442\u043E \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0444\u043E\u0440\u043C\u0443\u043B\u044B
      \u0438 \u0442\u0430\u0431\u043B\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 471379035021312
    m_Localized: "\u042D\u0442\u043E \u043F\u0440\u043E \u043F\u043E\u0438\u0441\u043A
      \u0440\u0435\u0448\u0435\u043D\u0438\u0439 \u0438 \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u044C
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 471443493085184
    m_Localized: "\u0422\u044B \u0437\u0434\u0435\u0441\u044C, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C, \u0430 \u043D\u0435
      \u0437\u0430\u0437\u0443\u0431\u0440\u0438\u0432\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 471485536788480
    m_Localized: "\u0421\u043C\u0435\u043B\u043E\u0441\u0442\u044C \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u2014 \u044D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E, \u043D\u043E
      \u0438\u0433\u0440\u044B \u0441 \u043A\u0430\u0440\u0442\u0430\u043C\u0438
      \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0442 \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 471526762602496
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435 \u0437\u043D\u0430\u043D\u0438\u044F
      \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B,
      \u0430 \u043D\u0435 \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B\u0445
      \u0432\u044B\u0431\u043E\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 471576897118208
    m_Localized: "\u0418 \u0432\u0441\u0451 \u0436\u0435, \u0414\u043C\u0438\u0442\u0440\u0438\u0439,
      \u043C\u0438\u0440 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 471628164096000
    m_Localized: "\u0418\u0433\u0440\u044B \u0434\u0430\u044E\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0430\u0443\u043A\u0443 \u0441
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 471681679220736
    m_Localized: "\u0422\u044B \u0441\u0430\u043C \u0437\u043D\u0430\u0435\u0448\u044C:
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443
      \u043F\u043E\u043D\u044F\u0442\u044C \u0447\u0442\u043E-\u0442\u043E, \u0438\u043D\u043E\u0433\u0434\u0430
      \u043D\u0443\u0436\u043D\u043E \u0448\u0430\u0433\u043D\u0443\u0442\u044C \u0432
      \u043D\u0435\u0438\u0437\u0432\u0435\u0434\u0430\u043D\u043D\u043E\u0435, \u0430
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0438\u0434\u0435\u0442\u044C
      \u0437\u0430 \u043A\u043D\u0438\u0436\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 471782413819904
    m_Localized: "\u042D\u0439, \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0431\u0435\u0437
      \u0441\u043F\u043E\u0440\u043E\u0432! \u041C\u043D\u0435 \u0432\u0441\u0451
      \u0435\u0449\u0451 \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C
      \u043A\u0430\u0440\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043C\u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 471827909435392
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u0440\u0430\u0437 \u0443\u0436
      \u044D\u0442\u043E \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442,
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F
      \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 471868883591168
    m_Localized: "\u0422\u044B \u043D\u0430 \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u043F\u0440\u0430\u0432,
      \u041F\u0430\u0448\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 471919999574016
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0438\u0439
      \u0432\u044B\u0431\u043E\u0440 \u2014 \u044D\u0442\u043E \u0442\u043E\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0442\u044B \u0441\u0434\u0435\u043B\u0430\u043B
      \u0441\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 472147997745152
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0432\u044B\u0431\u043E\u0440
      \u0434\u0430\u0451\u0442\u0441\u044F \u043B\u0435\u0433\u0447\u0435, \u0447\u0435\u043C
      \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 472210580955136
    m_Localized: "\u042D\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E
      \u0442\u0432\u043E\u0451\u043C \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 472265316622336
    m_Localized: "\u041A\u0430\u043A \u0445\u0438\u043C\u0438\u043A \u0442\u044B
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u0443\u044E \u0438\u0441\u0442\u0438\u043D\u0443:
      \"\u041D\u0435 \u0432\u0441\u0451, \u0447\u0442\u043E \u0431\u043B\u0435\u0441\u0442\u0438\u0442,
      \u2014 \u0437\u043E\u043B\u043E\u0442\u043E\"."
    m_Metadata:
      m_Items: []
  - m_Id: 472321591599104
    m_Localized: "\u0417\u043D\u0430\u0435\u0442\u0435, \u0414\u043C\u0438\u0442\u0440\u0438\u0439
      \u0418\u0432\u0430\u043D\u043E\u0432\u0438\u0447, \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u044F \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u0443\u0440\u043E\u043A \u0445\u0438\u043C\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 472380651593728
    m_Localized: "\u0425\u0430! \u0422\u043E\u0433\u0434\u0430 \u043D\u0430\u0447\u043D\u0438
      \u0441 \u0444\u043E\u0440\u043C\u0443\u043B\u044B \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 472422917595136
    m_Localized: "\u0428\u0443\u0442\u043A\u0438 \u0448\u0443\u0442\u043A\u0430\u043C\u0438,
      \u043D\u043E \u0435\u0441\u043B\u0438 \u0442\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0430\u0443\u0447\u0438\u0448\u044C\u0441\u044F \u043C\u044B\u0441\u043B\u0438\u0442\u044C,
      \u043A\u0430\u043A \u0443\u0447\u0451\u043D\u044B\u0439, \u044F \u0431\u0443\u0434\u0443
      \u0433\u043E\u0440\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 472484775190528
    m_Localized: "\u041E-\u043E-\u043E, \u0442\u044B \u0433\u043E\u0442\u043E\u0432
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0441\u0432\u043E\u0438\u0445 \u043D\u043E\u0432\u044B\u0445
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432, \u041F\u0430\u0448\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 472552295096320
    m_Localized: "\u0422\u044B \u0436\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u043D\u0438\u0445
      \u2014 \u044D\u0442\u043E \u043A\u0430\u043A \u044F\u0440\u043A\u0430\u044F,
      \u043D\u0435\u0432\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u043C\u0430\u044F
      \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 472589519544320
    m_Localized: "\u0414\u0430! \u042D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B! \u041E\u043D\u0438 \u043A\u0430\u043A
      \u0433\u0435\u0440\u043E\u0438, \u0433\u043E\u0442\u043E\u0432\u044B\u0435
      \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F \u0437\u0430 \u0442\u0435\u0431\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 472633513598976
    m_Localized: "\u0425\u043C, \u0434\u0430, \u043D\u043E \u043F\u043E\u0447\u0435\u043C\u0443
      \u0438\u043C\u0435\u043D\u043D\u043E \u0430\u043D\u0438\u043C\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438?
      \u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0443, \u043C\u0435\u0434\u0432\u0435\u0434\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 472668934496256
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0410\u043D\u0438\u043C\u0435
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0440\u0438\u0441\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438,
      \u044D\u0442\u043E - \u0434\u0443\u0445! \u042D\u0442\u043E \u0441\u0438\u043B\u0430,
      \u044D\u043D\u0435\u0440\u0433\u0438\u044F, \u044D\u0442\u043E \u0412\u0421\u0415!"
    m_Metadata:
      m_Items: []
  - m_Id: 472717466787840
    m_Localized: "\u0410 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0432
      \u0445\u0438\u043C\u0438\u0438, \u043E\u043D\u0438... \u041E\u043D\u0438 \u0442\u043E\u0436\u0435
      \u0438\u043C\u0435\u044E\u0442 \u0441\u0432\u043E\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438,
      \u0441\u0432\u043E\u044E \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 472771585892352
    m_Localized: "\u0418 \u0435\u0441\u043B\u0438 \u0442\u044B \u0432\u0438\u0434\u0438\u0448\u044C
      \u0432 \u043D\u0438\u0445 \u0430\u043D\u0438\u043C\u0435-\u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439,
      \u0442\u043E \u0442\u044B \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C
      \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u0438\u0445 \u043A\u0430\u043A
      \u041B\u042E\u0414\u0415\u0419!"
    m_Metadata:
      m_Items: []
  - m_Id: 472810987184128
    m_Localized: "\u041E\u043D\u0438 \u043E\u0431\u0436\u0438\u0433\u0430\u044E\u0442,
      \u043E\u043D\u0438 \u0432\u0437\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F,
      \u043E\u043D\u0438 \u0432\u043B\u044E\u0431\u043B\u044F\u044E\u0442\u0441\u044F,
      \u043E\u043D\u0438 \u0442\u0435\u0440\u0437\u0430\u044E\u0442 \u0434\u0443\u0448\u0443!
      \u0418 \u043E\u043D\u0438 \u0431\u0443\u0434\u0443\u0442 \u0442\u0432\u043E\u0438\u043C\u0438
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u043C\u0438, \u041F\u0430\u0448\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 472848542982144
    m_Localized: "\u041E\u043A\u0435\u0439. \u041D\u0443, \u0442\u043E\u0433\u0434\u0430
      \u044F \u0432\u044B\u0431\u0438\u0440\u0430\u044E..."
    m_Metadata:
      m_Items: []
  - m_Id: 473221974450176
    m_Localized: "\u042D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
