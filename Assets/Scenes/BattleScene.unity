  m_FontData:
    m_Font: {fileID: 12800000, guid: 03a224fe152f5444da08ef06c8fb7a2e, type: 3}
    m_FontSize: 38
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
