  m_Text: "\u0422\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043A\u0430\u0440\u0442\u0443
    \xAB\u041A\u0440\u0435\u043C\u043D\u0438\u0439\xBB, \u043D\u043E \u043D\u0435
    \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u044B\u0433\u0440\u0430\u0442\u044C
    \u0435\u0451, \u043F\u043E\u043A\u0430 \u0442\u0432\u043E\u0439 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0439
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043D\u0435 \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0435\u0442
    3 \u2014 \u0443\u0440\u043E\u0432\u043D\u044F \u044D\u0442\u043E\u0439 \u043A\u0430\u0440\u0442\u044B."
