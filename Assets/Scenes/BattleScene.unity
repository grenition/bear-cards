  m_Text: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0445\u043E\u0434 \u0442\u0435\u0431\u0435
    \u0431\u0443\u0434\u0443\u0442 \u0434\u0430\u0432\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0435\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F
    \u043C\u0430\u043B\u043E \u043A\u0430\u0440\u0442 \u0432 \u0440\u0443\u043A\u0435,
    \u0430 \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435
    \u2014 \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043A\u043E\u043B\u043E\u0434\u0443."
